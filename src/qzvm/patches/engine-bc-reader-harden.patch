@@ -39754,9 +39792,57 @@ static JSValue JS_ReadFunctionTag(BCReaderState *s)
     byte_code_offset = function_size;
     function_size += bc.byte_code_len;
 
+    /* qwrt fix: the writer emits local_count == arg_count + var_count
