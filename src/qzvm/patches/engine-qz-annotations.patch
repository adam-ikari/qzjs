+/* qzjs AOT annotation side table: attach/retrieve raw bytes on a function bytecode object. */
+static JSFunctionBytecode *qz_get_function_bytecode(JSValueConst v)
+{
+    if (JS_VALUE_GET_TAG(v) == JS_TAG_FUNCTION_BYTECODE)
+        return JS_VALUE_GET_PTR(v);
+    if (JS_VALUE_GET_TAG(v) == JS_TAG_OBJECT) {
+        JSObject *p = JS_VALUE_GET_OBJ(v);
+        if (p->class_id == JS_CLASS_BYTECODE_FUNCTION)
+            return p->u.func.function_bytecode;
+    }
+    return NULL;
+}
+
+JSValue JS_GetFunctionBytecodeValue(JSContext *ctx, JSValueConst func)
+{
+    JSFunctionBytecode *b = qz_get_function_bytecode(func);
+    if (!b)
+        return JS_EXCEPTION;
+    return JS_MKPTR(JS_TAG_FUNCTION_BYTECODE, b);
+}
+
+int JS_SetFunctionAnnotation(JSContext *ctx, JSValueConst func, const uint8_t *data, size_t len)
+{
+    JSFunctionBytecode *b = qz_get_function_bytecode(func);
+    if (!b)
+        return -1;
+    if (b->qz_annot)
+        js_free(ctx, b->qz_annot);
+    b->qz_annot = NULL;
+    b->qz_annot_len = 0;
+    if (len > 0) {
+        b->qz_annot = js_malloc(ctx, len);
+        if (!b->qz_annot)
+            return -1;
+        memcpy(b->qz_annot, data, len);
+        b->qz_annot_len = (int)len;
+    }
+    return 0;
+}
+
+const uint8_t *JS_GetFunctionAnnotation(JSContext *ctx, JSValueConst func, size_t *plen)
+{
+    JSFunctionBytecode *b = qz_get_function_bytecode(func);
+    if (!b)
+        return NULL;
+    if (plen)
+        *plen = (size_t)b->qz_annot_len;
+    return (const uint8_t *)b->qz_annot;
+}
