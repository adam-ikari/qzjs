--- a/quickjs.c
+++ b/quickjs.c
@@ -2660,6 +2660,47 @@
         rt->rt_info = s;
 }
 
+static void gc_free_cycles(JSRuntime *rt);
+
+/* teardown 强制清扫：打断（uncatchable InterruptedError）会让部分 GC 对象
+   残留 GC 不可见的外部引用，refcount > 0 留在 gc_obj_list，逃过 gc_free_cycles
+   （后者只处理 tmp_obj_list 里 refcount==0 的对象）。rt 即将销毁，这些对象
+   不可能被访问到；把它们送回 gc_free_cycles 走标准 free_object 路径释放，
+   否则其 arena 内存（含 bytecode）会真泄漏（THREAD 模型下反复 create/destroy
+   累积）。gc_free_cycles 内的 gc_phase==REMOVE_CYCLES 保护保证即使 refcount
+   非 0 也会经 gc_zero_ref_count_list 统一 js_free_rt。 */
+static void gc_force_sweep(JSRuntime *rt)
+{
+    struct list_head *el, *el1;
+    JSGCObjectHeader *p;
+    bool progress;
+
+    do {
+        progress = false;
+        list_for_each_safe(el, el1, &rt->gc_obj_list) {
+            p = list_entry(el, JSGCObjectHeader, link);
+            if (JS_GC_TYPE(p) == JS_GC_OBJ_TYPE_JS_OBJECT ||
+                JS_GC_TYPE(p) == JS_GC_OBJ_TYPE_FUNCTION_BYTECODE) {
+                list_del(&p->link);
+                list_add_tail(&p->link, &rt->tmp_obj_list);
+                progress = true;
+            }
+        }
+        if (progress)
+            gc_free_cycles(rt);
+    } while (progress);
+
+    /* 剩余为无主辅助结构（shape/proto 等）。它们通常已被 free_object 的
+       remove_gc_object 连带清理；此处只报告，不强释——直接 js_free_rt 有
+       double-free 风险，崩溃比残留更糟。 */
+    if (!list_empty(&rt->gc_obj_list)) {
+        int n = 0;
+        list_for_each(el, &rt->gc_obj_list)
+            n++;
+        fprintf(stderr, "quickjs: gc_force_sweep: %d orphan GC headers left\n", n);
+    }
+}
+
