# Build artifacts
build/
build_*/
build-*/
*.o
*.a
*.so
*.dylib
*.dll
# VS Code extension bundle output (npm run compile)
vscode/qzjs-debug/out/

# Generated files
# NOTE: dist/polyfill.js + dist/polyfill.bytecode + src/polyfill_default.c and
# dist/worker-boot.bytecode + src/worker_boot_default.c are deliberately
# force-tracked (git add -f) as shipped build artifacts so a fresh clone
# compiles without re-running the polyfill build. The rules below only stop
# *other* output under dist/, plus the per-mode generated sources listed at the
# end of this section.
dist/
polyfill.js
src/polyfill_default.c.bak

# Per-mode generated sources from polyfill/build.js: rodata writes the
# force-tracked baseline src/polyfill_default.c, the other three modes write
# their own build-local file. Listed explicitly rather than as
# src/polyfill_*.c so a future hand-written src/polyfill_<name>.c is not
# silently ignored.
src/polyfill_compressed.c
src/polyfill_external.c
src/polyfill_host.c

# Node.js
node_modules/
package-lock.json
# but commit the docs site lockfile (CI reproducibility)
!docs/package-lock.json

# IDE / editor
.vscode/
.idea/
*.swp
*~
.DS_Store

# Coverage
coverage/
*.gcov
*.gcda
*.gcno

# Debug / sanitizer
build_asan/
build_check/
*.asan
*.lsan

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Doxygen output
docs/api/

# Local pi agent config
.pi/

# Agent session artifacts
.workflow/

# Python
__pycache__/
.pytest_cache/
*.pyc

# Claude Code skill symlinks (point at .agents/skills)
.claude/
